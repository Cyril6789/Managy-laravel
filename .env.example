APP_NAME=Managy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# SaaS edition guard — MUST be "saas" on this branch.
APP_EDITION=saas

# Central host and scheme. In production, wildcard DNS *.managy.fr and the
# Traefik HostRegexp router must point every tenant hostname to this app.
SAAS_DOMAIN=localhost
SAAS_SCHEME=http
SAAS_RESERVED_SUBDOMAINS=www,admin,api,mail

# Platform super-admin created on first `php artisan db:seed`.
SUPER_ADMIN_EMAIL=admin@managy.fr
SUPER_ADMIN_PASSWORD=password
SUPER_ADMIN_NAME="Super Admin"

SAAS_EMAIL_VERIFICATION=false
SAAS_REGISTRATION_ENABLED=true

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production: share the session across managy.fr and all tenant subdomains.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SSO credentials are normally configured per society in the database.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
# Keep OAuth callbacks on the central domain in production.
AZURE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
